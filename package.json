{
  "name": "klinik-profesional",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --project tsconfig.check.json --noEmit --incremental false",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "tsx scripts/seed.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "backup": "node scripts/backup.mjs",
    "import:content": "tsx scripts/import-content.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "test:browser": "node scripts/test.mjs browser",
    "test:workflow": "node scripts/test.mjs workflow",
    "test:email": "node scripts/test.mjs email",
    "format": "prettier --write src scripts tests",
    "format:check": "prettier --check src scripts tests",
    "test:admin": "node scripts/test.mjs admin",
    "test:integration": "node scripts/test.mjs integration",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && node scripts/test.mjs all",
    "lint": "node scripts/lint.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "dotenv": "^17.2.3",
    "graphql": "^16.11.0",
    "lucide-react": "^0.577.0",
    "next": "^16.3.3",
    "payload": "3.90.2",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/smtp-server": "^3.5.13",
    "prettier": "^3.9.9",
    "smtp-server": "^3.19.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "sharp": "$sharp",
    "nodemailer": "^10.0.14",
    "undici": "^7.30.0",
    "sass": "^1.105.1",
    "dompurify": "^3.4.16",
    "esbuild": "^0.25.12"
  }
}
